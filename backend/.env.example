# Set model names from the current Groq console model list.
GROQ_API_KEY=
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_REASONING_EFFORT=low
MAX_COMPLETION_TOKENS=4096
ENABLE_VISION_CROSSCHECK=true
MAX_FILE_MB=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OCR_LANGUAGES=en
ELA_RATIO_THRESHOLD=4.0
NAME_MATCH_THRESHOLD=0.82
